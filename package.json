{
  "name": "@gksruf22/nore",
  "version": "0.1.0",
  "description": "Raise the cost of reverse-engineering your web/Electron JS app: a zero-dependency runtime anti-analysis guard (CDP/devtools/integrity detection) plus a Vite hardening plugin (sourcemap stripping + obfuscation).",
  "type": "module",
  "license": "MIT",
  "author": "NoRE contributors",
  "homepage": "https://github.com/gksruf22/nore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gksruf22/nore.git"
  },
  "bugs": {
    "url": "https://github.com/gksruf22/nore/issues"
  },
  "keywords": [
    "anti-debug",
    "anti-reverse-engineering",
    "anti-tamper",
    "obfuscation",
    "devtools-detection",
    "cdp",
    "integrity",
    "vite-plugin",
    "electron",
    "security"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js",
      "require": "./dist/electron.cjs"
    }
  },
  "bin": {
    "nore": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "bench": "npm run build && node scripts/bench.mjs",
    "perf": "npm run build && node scripts/perf.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "javascript-obfuscator": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
